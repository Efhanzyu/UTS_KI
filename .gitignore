# Environment variables and local secrets
.env
.env.*
!.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.xml

# Application generated files (jangan commit)
uploads/
temp/
tmp/
