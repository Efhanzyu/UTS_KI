# ─────────────────────────────────────────────────────────────────
# Brankas File Tugas Kuliah — Environment Variables
#
# Salin file ini menjadi .env:
#   cp .env.example .env
#
# JANGAN commit file .env ke repository!
# JANGAN masukkan secret ke file ini!
# ─────────────────────────────────────────────────────────────────

# Flask session signing key; set a unique random value in the local .env file.
SECRET_KEY=

# Lingkungan aplikasi: development atau production
FLASK_ENV=development

# ─────────────────────────────────────────────────────────────────
# PBKDF2-HMAC-SHA256 Iterations
#
# Nilai default: 600.000 (NIST SP 800-132 recommendation 2023)
# Lebih tinggi = lebih aman (lebih lambat brute-force)
# Lebih rendah = lebih cepat (kurang aman)
#
# JANGAN gunakan nilai di bawah 100.000 untuk production.
# ─────────────────────────────────────────────────────────────────
PBKDF2_ITERATIONS=600000

# Ukuran maksimum file upload dalam MB
MAX_CONTENT_MB=64

PORT=5000
BENCHMARK_KDF_ITERATIONS=1000
BENCHMARK_RUNS=10
