# Brankas File Tugas Kuliah - environment template
# Salin ke .env sebelum menjalankan aplikasi secara lokal.
# Jangan commit secret atau credentials asli.

SECRET_KEY=
FLASK_ENV=development
PBKDF2_ITERATIONS=600000
MAX_CONTENT_MB=50

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=brankas-files

# Optional benchmark tuning used by the current app config.
BENCHMARK_KDF_ITERATIONS=1000
BENCHMARK_RUNS=10
